# Supabase — create project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres

# Auth — comma-separated admin emails
ADMIN_EMAILS=you@example.com

# Resend — create account at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply<reservas@yourdomain.pe>

# Email that receives admin notifications (new reservations + event quotes).
# Leave blank to fall back to the adminEmail stored in settings.
NOTIFY_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.pe
